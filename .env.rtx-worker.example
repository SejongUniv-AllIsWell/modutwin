# 원격 GPU 워커(RTX NVIDIA GPU) 전용 .env 예시
# docker-compose.gpu-rtx.yml 과 함께 사용. 이 파일을 .env.rtx-worker 로 복사해 채운다.
#
# 비밀값(RABBITMQ/REDIS/MINIO/토큰)은 PC(웹서버)의 .env 와 반드시 동일해야 한다.

# PC(웹서버)의 접근 가능한 IP/호스트. Tailscale 등 사설망 IP 권장.
PC_HOST_IP=100.x.x.x

# 메시지 브로커 / 캐시 (PC 와 동일 값)
RABBITMQ_DEFAULT_USER=changeme
RABBITMQ_DEFAULT_PASS=changeme
REDIS_PASSWORD=changeme

# 오브젝트 스토리지 (PC 와 동일 값)
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=3dgs-platform

# 백엔드 콜백 (RTX 머신에서 PC 백엔드에 도달하는 주소).
# nginx 경유: http://${PC_HOST_IP}/api   /   백엔드 8000 직노출 시: http://${PC_HOST_IP}:8000
BACKEND_CALLBACK_URL=http://100.x.x.x/api
WORKER_CALLBACK_TOKEN=changeme
# notify_upload_progress(backend_callback.py)용. /api 없이 backend/nginx base URL 을 넣는다.
BACKEND_INTERNAL_URL=http://100.x.x.x
INTERNAL_API_TOKEN=

# door-ml(SAM3) 용 — facebook/sam3 gated 모델 접근 토큰 (HuggingFace).
# PC 백엔드 .env 에는 DOOR_ML_URL=http://<RTX_IP>:8100 으로 등록한다.
HF_TOKEN=
DOOR_ML_PORT=8100

# RTX 5090(Blackwell)=12.0 기준. RTX 30(Ampere)=8.6, RTX 40(Ada)=8.9도 포함.
TORCH_CUDA_ARCH_LIST=8.6 8.9 12.0+PTX
PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
GSPLAT_REF=main
GSPLAT_MAX_STEPS=7000
WORKER_SHM_SIZE=12gb

# COLMAP은 RTX worker 이미지에서 CUDA 지원 source build로 설치한다.
# RTX 30(Ampere)=86, RTX 40(Ada)=89, RTX 50(Blackwell)=120.
COLMAP_REF=3.12.6
COLMAP_CUDA_ARCHITECTURES=86

# COLMAP 프레임 추출/매칭 튜닝.
QT_QPA_PLATFORM=offscreen
COLMAP_MATCHER=sequential
COLMAP_FRAME_FPS=1
COLMAP_USE_GPU=1
COLMAP_NUM_THREADS=2
COLMAP_MAX_IMAGE_SIZE=3840
COLMAP_SEQUENTIAL_OVERLAP=20

# SOG 변환 튜닝. auto 는 NVIDIA/Vulkan 어댑터 우선, 실패 시 worker_rtx/tasks/sog.py 가 CPU 폴백.
SOG_DEVICE=auto
SOG_DAWN_BACKEND=vulkan
SOG_PREFER_NVIDIA=1
SOG_ITERATIONS=10
SOG_TIMEOUT=3600

# NVIDIA Container Toolkit 런타임 노출.
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics
